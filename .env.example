NODE_ENV=development
PORT=3001
HOST=127.0.0.1
WEB_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:replace-with-a-local-password@127.0.0.1:54331/platform_dev
DATABASE_SSL=false
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
COOKIE_SECRET=replace-with-a-different-random-secret-at-least-32-characters
CORS_ORIGIN=http://localhost:3000,http://localhost:1420

# Judge: leave unset to disable runs, or select the clearly unsafe dev fixture only on a private workstation.
JUDGE_PROVIDER=
JUDGE0_URL=http://127.0.0.1:2358
JUDGE0_AUTH_TOKEN=
ENABLE_STUDENT_EXECUTION=false
JUDGE_WORKER_CONCURRENCY=2

# Local Mailpit: http://127.0.0.1:8025
EMAIL_PROVIDER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=PLATFORM <no-reply@localhost>

STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.local/storage
STORAGE_MAX_FILE_BYTES=10485760

DEV_POSTGRES_DB=platform_dev
DEV_POSTGRES_USER=postgres
DEV_POSTGRES_PASSWORD=replace-with-a-local-database-password
DEV_POSTGRES_PORT=54331

# --- Student desktop, offline-first mode (phase 05). Build-time Vite variables; values are public. ---
# Set to 1 to use Supabase sign-in, local attempts and Oracle Object Storage sync.
VITE_OFFLINE_FIRST=
VITE_SUPABASE_URL=
# The Supabase anon (public) key. Never put the service-role key here.
VITE_SUPABASE_ANON_KEY=
# Optional; defaults to ${VITE_SUPABASE_URL}/functions/v1
VITE_FUNCTIONS_URL=
# Read-only PAR base URL for packs/lang/ (C3), ending in /o/
VITE_LANG_PACKS_BASE_URL=
