{
  "name": "@lplatform/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run src/tests/unit",
    "test:integration": "vitest run src/tests/integration",
    "test:judge0": "vitest run src/tests/judge0/real-judge0.acceptance.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:test-clean": "tsx src/db/migrate.ts --clean",
    "db:migrate:test-upgrade": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "judge:worker": "tsx src/modules/judge/worker.ts",
    "judge:worker:start": "node dist/modules/judge/worker.js",
    "recheck:worker": "tsx src/modules/judge/recheck-worker.ts",
    "db:bootstrap": "tsx src/db/bootstrap.ts",
    "db:bootstrap:prod": "node dist/db/bootstrap.js",
    "db:migrate:prod": "node dist/db/migrate.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^6.1.3",
    "@lplatform/language-config": "workspace:*",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.2.1",
    "jose": "^6.0.8",
    "nodemailer": "10.5.0",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^11.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.11.11",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
