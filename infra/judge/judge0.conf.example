# Judge0 CE v1.13.1 settings. Set strong unique secrets in judge0.env.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-long-random-secret
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=judge0
POSTGRES_USER=judge0
POSTGRES_PASSWORD=replace-with-a-different-long-random-secret

# Require an API token for every request. Share this value only with the API worker.
AUTHN_HEADER=X-Auth-Token
AUTHN_TOKEN=replace-with-a-third-long-random-secret
AUTHZ_HEADER=X-Auth-Token
AUTHZ_TOKEN=replace-with-a-third-long-random-secret

# Keep queues bounded and limit requested resources.
MAX_QUEUE_SIZE=100
MAX_SUBMISSION_BATCH_SIZE=20
CPU_TIME_LIMIT=2
MAX_CPU_TIME_LIMIT=10
MAX_WALL_TIME_LIMIT=20
MAX_MEMORY_LIMIT=262144
MAX_PROCESSES_AND_OR_THREADS=60
MAX_FILE_SIZE=1024
ENABLE_NETWORK=false
ALLOW_ENABLE_NETWORK=false
ENABLE_SUBMISSION_DELETE=false
